# Only the files needed to build and run the local web project.
/*
!/.gitignore
!/.github/
!/README.md
!/LOCAL-WEB-fa.md
!/package.json
!/package-lock.json
!/backend/
!/start-local-web.cmd
!/local-web-src/
!/local-web-assets/
!/tests/
!/tools/
!/recovered/

/tools/*
!/tools/build-local-web.mjs
!/tools/serve-web.py
!/tools/verify-local-build.mjs
!/tools/js-vendor/

/recovered/*
!/recovered/landing.html
!/recovered/web/
/recovered/web/*
!/recovered/web/_expo/
!/recovered/web/assets/
!/recovered/web/readable/
!/recovered/web/manifest.json
!/recovered/web/anbari-icon-512.png
!/recovered/web/anbari-touch-icon.png
!/recovered/web/favicon.ico
!/recovered/web/notifications-sw.js

**/__pycache__/
**/node_modules/
**/*.log
**/.env
**/.env.*
**/*.pem
**/*.key
**/api.env
